<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>AstrLink.Shell.Tray</RootNamespace>
    <AssemblyName>AstrLink.Shell</AssemblyName>
    <ApplicationIcon />
    <Description>AstrLink .NET 10 tray shell</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AstrLink.Shell.Core\AstrLink.Shell.Core.csproj" />
  </ItemGroup>
</Project>
